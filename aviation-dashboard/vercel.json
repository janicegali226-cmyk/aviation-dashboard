{
  "builds": [
    {
      "src": "api/**/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron_opensky",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron_airport",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron_oilprice",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron_cost",
      "schedule": "0 3 * * *"
    }
  ]
}